<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <changeSet id="drop_language_and_currency_from_user" author="muybien3433">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="user" columnName="language"/>
        </preConditions>

        <dropColumn tableName="user" columnName="language"/>
    </changeSet>

    <changeSet id="drop_currency_from_user" author="muybien3433">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="user" columnName="currency"/>
        </preConditions>

        <dropColumn tableName="user" columnName="currency"/>
    </changeSet>

    <changeSet id="add_user_config" author="muybien3433">
        <createTable tableName="user_config">
            <column name="id" type="${uuidType}"><constraints primaryKey="true" nullable="false"/></column>
            <column name="language" type="varchar(10)"><constraints nullable="true"/></column>
            <column name="currency" type="varchar(10)"><constraints nullable="true"/></column>
            <column name="user_id" type="${uuidType}"><constraints nullable="false"/></column>
            <column name="created_by" type="varchar(20)"><constraints nullable="false"/></column>
            <column name="created_date" type="timestamp"/>
            <column name="last_modified_by" type="varchar(20)"/>
            <column name="last_modified_date" type="timestamp"/>
        </createTable>

        <addUniqueConstraint tableName="user_config"
                             columnNames="user_id"
                             constraintName="uk_user_config_user_id"/>

        <addForeignKeyConstraint baseTableName="user_config"
                                 baseColumnNames="user_id"
                                 referencedTableName="user"
                                 referencedColumnNames="id"
                                 constraintName="fk_user_config_user"/>
    </changeSet>

</databaseChangeLog>
